{
    "name": "@seymi/dnss-cli",
    "version": "1.0.1",
    "description": "DNSS (DNS Switcher) - a CLI to change your DNS servers on Windows, macOS and Linux. DNS changer with built-in presets, benchmarking and easy config management.",
    "keywords": [
        "dns",
        "dns changer",
        "dns switch",
        "dns switcher",
        "dnss",
        "network",
        "netsh",
        "cli",
        "dns-changer"
    ],
    "license": "MIT",
    "author": "SeyMi",
    "maintainers": [
        "SeyMi"
    ],
    "bin": {
        "dnss": "dist/index.js"
    },
    "main": "dist/index.js",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit --skipLibCheck",
        "prettier": "prettier --write .",
        "prettier:check": "prettier --check .",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts"
    },
    "dependencies": {
        "@seymi/dnss-core": "^1.0.0",
        "chalk": "^4.1.2",
        "inquirer": "^12.4.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Hasan-Mir/dns-changer.git"
    },
    "bugs": {
        "url": "https://github.com/Hasan-Mir/dns-changer/issues"
    },
    "homepage": "https://github.com/Hasan-Mir/dns-changer#readme"
}
