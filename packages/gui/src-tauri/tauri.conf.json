{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "DNSS",
    "version": "1.1.0",
    "identifier": "com.dnss.switcher",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "DNSS - DNS Switcher",
                "width": 920,
                "height": 660,
                "minWidth": 720,
                "minHeight": 520,
                "resizable": true,
                "decorations": false,
                "center": true,
                "backgroundColor": "#0f1115"
            },
            {
                "label": "tray",
                "title": "DNSS Tray",
                "url": "index.html?view=tray",
                "width": 360,
                "height": 520,
                "resizable": false,
                "decorations": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "backgroundColor": "#0f1115"
            }
        ],
        "security": {
            "devCsp": null,
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Utility",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
