{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ES2022",
        "noEmit": true,
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "baseUrl": ".",
        "paths": {
            "@gui/*": ["../packages/gui/src/*"],
            "@seymi/dnss-core/*": ["../packages/core/src/*"]
        }
    },
    "include": ["src", "vite.config.mts"]
}
